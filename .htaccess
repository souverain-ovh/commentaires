# Souverain Commentaires
# Souverain.ovh

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; connect-src https:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
</IfModule>


# Fichiers de configuration internes : exécutés par PHP mais non consultables.
<FilesMatch "^(config|config\.example|lib|securite)\.php$">
    Require all denied
</FilesMatch>
